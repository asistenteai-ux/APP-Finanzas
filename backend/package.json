{
  "name": "app-finanzas-backend",
  "version": "1.0.0",
  "description": "Backend para sistema de gestión financiera y tributaria SII Chile",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "build:exe": "node build-exe.js",
    "build:exe:manual": "npm run build && pkg dist/server.js --targets node18-win-x64 --output ../app-finanzas.exe"
  },
  "keywords": [
    "sii",
    "chile",
    "facturacion",
    "tributario",
    "dte"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "better-sqlite3": "^9.2.2",
    "xml2js": "^0.6.2",
    "node-forge": "^1.3.1",
    "axios": "^1.6.2",
    "soap": "^1.0.0",
    "fast-xml-parser": "^4.3.3",
    "date-fns": "^3.0.0",
    "zod": "^3.22.4",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "tesseract.js": "^5.0.4",
    "pdf.js-extract": "^0.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/xml2js": "^0.4.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "pkg": "^5.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/tesseract.js/**/*",
      "../.env"
    ],
    "scripts": [
      "dist/**/*.js"
    ]
  }
}
